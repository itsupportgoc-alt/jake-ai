{
  "name": "jake-ai",
  "productName": "JAKE AI",
  "version": "1.1.0",
  "description": "JAKE AI — authorized website penetration testing and system account security agent",
  "author": "JAKE AI",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "mysql2": "^3.11.4",
    "playwright-core": "^1.48.2",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/node": "^22.8.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.454.0",
    "monaco-editor": "^0.52.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "ai.jake.desktop",
    "productName": "JAKE AI",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "asarUnpack": ["node_modules/sql.js/**", "node_modules/playwright-core/**"],
    "win": {
      "target": ["nsis"],
      "artifactName": "JAKE-AI-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JAKE AI"
    }
  }
}
